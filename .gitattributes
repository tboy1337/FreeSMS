# Normalize text files to LF in the repository (cross-platform Python + GitHub Actions).
* text=auto eol=lf

# Windows scripts keep CRLF when checked out on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (GUI icons, etc.)
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary

# Tooling config without a conventional extension
.gitattributes text eol=lf
.gitignore text eol=lf
pylintrc text eol=lf
.coveragerc text eol=lf
